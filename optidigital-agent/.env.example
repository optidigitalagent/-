TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Select exactly one operator model. In SINGLE_SHARED_OPERATOR mode leave all
# three separate-role IDs blank. Never commit a real numeric Telegram ID.
TELEGRAM_OPERATOR_MODE=SEPARATE_ROLES
TELEGRAM_SHARED_OPERATOR_USER_ID=
TELEGRAM_ADULT_OWNER_USER_ID=
TELEGRAM_ARTEM_USER_ID=
TELEGRAM_VADIM_USER_ID=
OPENAI_API_KEY=
FREELANCEHUNT_TOKEN=
DATABASE_URL=

# Gmail Agent (optional — disabled by default)
GMAIL_ENABLED=false
GMAIL_USE_MOCK=true
GMAIL_MIN_SCORE=6
GMAIL_CHECK_INTERVAL_MINUTES=1
GMAIL_LOOKBACK_DAYS=7
GMAIL_DIGEST_ENABLED=true

# Official public Freelancehunt RSS discovery (no login/cookies required)
FREELANCEHUNT_DISCOVERY_ENABLED=true
FREELANCEHUNT_DISCOVERY_INTERVAL_SECONDS=60
FREELANCEHUNT_DISCOVERY_MAX_NEW_PER_SCAN=10
# Exact adult-owned mailbox. Required in real mode; keep as a Railway secret.
GMAIL_EXPECTED_ACCOUNT=

# Railway-safe: set these to the full JSON content of the credential files
# (copy-paste the file contents as a single-line JSON string)
GMAIL_CREDENTIALS_JSON=
GMAIL_TOKEN_JSON=

# File fallback (local development only)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=gmail_token.json
